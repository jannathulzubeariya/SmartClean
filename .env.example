# ==============================================================================
# SMARTCLEAN - Environment Configuration Example
# Copy this file to .env or .env.local for local overrides.
# In production (e.g. Vercel), configure environment variables in project settings.
# ==============================================================================

# Server Port (Node.js full-stack engine)
# Defaults to 3000 if omitted.
PORT=3000

# Standalone Python Flask port (when executing backend/app.py directly)
# Defaults to 5000 if omitted.
FLASK_PORT=5000

# Node Environment ('development' | 'production')
NODE_ENV=production

# Custom Data Directory (Optional)
# Leave empty for automatic platform-safe resolution:
# - Local: ./backend/data
# - Serverless/Vercel: system temp directory (/tmp/smartclean_data)
# DATA_DIR=/path/to/custom/data

# Optional: Gemini API Key for extended AI storage insights
# GEMINI_API_KEY=your_gemini_api_key_here
